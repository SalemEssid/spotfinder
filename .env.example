# Copy this file to `.env` to override the development defaults.
# Every value below is optional in development: the API falls back to these defaults.

# --- API -------------------------------------------------------------------
PORT=3000
# Origin allowed by CORS (the Angular dev server).
CLIENT_ORIGIN=http://localhost:4200
# Secret used to sign login tokens. REQUIRED in production: use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ----------------------------------------------------------------
# Default: the Docker Compose database (`npm run db:up`), exposed on port 5433.
DATABASE_URL=postgres://spotfinder:spotfinder@localhost:5433/spotfinder
# Tests use a separate database (created automatically) so demo data is never touched.
TEST_DATABASE_URL=postgres://spotfinder:spotfinder@localhost:5433/spotfinder_test

# Without Docker: point both URLs to your local PostgreSQL instead, e.g.
# DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/spotfinder
# TEST_DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/spotfinder_test
